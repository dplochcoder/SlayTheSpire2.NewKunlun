<Window
  x:Class="CardArtClipper.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="New Kunlun Art Clipper"
  Width="1700"
  Height="950"
  MinWidth="1050"
  MinHeight="650"
  WindowStyle="SingleBorderWindow"
  WindowState="Normal"
  KeyDown="Window_OnKeyDown"
>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="Select gallery _folder…" Click="SelectGalleryFolder_OnClick" />
        <Separator />
        <MenuItem Header="E_xit" Click="Exit_OnClick" />
      </MenuItem>
      <MenuItem Header="_Options" Click="Options_OnClick" />
    </Menu>

    <Grid x:Name="RootGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="180" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="390" MinWidth="280" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="430" MinWidth="240" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox
            x:Name="CompletionFilterBox"
            SelectedIndex="0"
            SelectionChanged="CompletionFilterBox_OnSelectionChanged"
          >
            <ComboBoxItem Content="All" Tag="Both" />
            <ComboBoxItem Content="Completed" Tag="Completed" />
            <ComboBoxItem Content="Incomplete" Tag="Incomplete" />
          </ComboBox>
          <Button
            Grid.Column="1"
            Content="Refresh"
            Margin="6,0,0,0"
            Padding="9,3"
            Click="RefreshCards_OnClick"
          />
          <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,6,0,0"
            VerticalContentAlignment="Center"
            ToolTip="Filter card titles"
            TextChanged="SearchBox_OnTextChanged"
          />
        </Grid>
        <ListBox
          x:Name="CardList"
          Grid.Row="1"
          SelectionChanged="CardList_OnSelectionChanged"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          VirtualizingPanel.IsVirtualizing="True"
        >
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="2,3">
                <TextBlock Text="{Binding StatusGlyph}" Width="24" FontWeight="Bold">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#D94A4A" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsComplete}" Value="True">
                          <Setter Property="Foreground" Value="#32A852" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TabControl
          x:Name="AssetKindTabs"
          Grid.Row="2"
          Margin="0,8,0,0"
          SelectedIndex="0"
          SelectionChanged="AssetKindTabs_OnSelectionChanged"
        >
          <TabItem Header="Cards" Tag="Card" />
          <TabItem Header="Powers" Tag="Power" />
          <TabItem Header="Relics" Tag="Relic" />
        </TabControl>
      </Grid>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

      <Grid Grid.Column="2" Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
          <TextBlock
            x:Name="PreviewHeading"
            Text="Card previews (1:1)"
            FontWeight="SemiBold"
            VerticalAlignment="Center"
          />
        </DockPanel>
        <TextBlock
          x:Name="SmallPreviewLabel"
          Grid.Row="1"
          Text="Small — 250 × 190"
          Margin="0,0,0,4"
        />
        <ScrollViewer
          Grid.Row="2"
          VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Auto"
        >
          <StackPanel>
            <Border
              BorderBrush="#555"
              BorderThickness="1"
              x:Name="SmallPreviewBorder"
              Width="252"
              Height="192"
              HorizontalAlignment="Left"
            >
              <Image x:Name="SmallPreview" Width="250" Height="190" Stretch="None" />
            </Border>
            <TextBlock x:Name="LargePreviewLabel" Text="Large — 1000 × 760" Margin="0,12,0,4" />
            <Border
              x:Name="LargePreviewBorder"
              BorderBrush="#555"
              BorderThickness="1"
              Width="1002"
              Height="762"
              HorizontalAlignment="Left"
            >
              <Image x:Name="LargePreview" Width="1000" Height="760" Stretch="None" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" />

      <Grid Grid.Column="4" Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="CropTitle" Text="Crop" FontWeight="SemiBold" Margin="0,0,0,8" />
        <local:CropperControl
          xmlns:local="clr-namespace:CardArtClipper"
          x:Name="Cropper"
          Grid.Row="1"
        />
      </Grid>

      <GridSplitter Grid.Column="5" Width="5" HorizontalAlignment="Stretch" />

      <Grid Grid.Column="6" Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,6">
          <Button Content="Select folder…" Padding="9,3" Click="SelectGalleryFolder_OnClick" />
          <Button
            Content="Refresh"
            DockPanel.Dock="Right"
            Padding="9,3"
            Click="RefreshGallery_OnClick"
          />
        </DockPanel>
        <TextBlock
          x:Name="GalleryPathText"
          Grid.Row="1"
          Foreground="#777"
          TextTrimming="CharacterEllipsis"
          Margin="0,0,0,6"
        />
        <ListBox
          x:Name="GalleryList"
          Grid.Row="2"
          BorderThickness="0"
          Background="Transparent"
          SelectionChanged="GalleryList_OnSelectionChanged"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          VirtualizingPanel.IsVirtualizing="True"
          VirtualizingPanel.VirtualizationMode="Recycling"
        >
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel IsItemsHost="True" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid
                Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                Margin="2"
              >
                <Border BorderBrush="#555" BorderThickness="1" Background="#222">
                  <Image
                    Source="{Binding Thumbnail}"
                    Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                    Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                    Stretch="UniformToFill"
                  />
                </Border>
                <Border VerticalAlignment="Bottom" Background="#B0000000">
                  <TextBlock
                    Text="{Binding Name}"
                    Foreground="White"
                    FontSize="11"
                    Padding="3,2"
                    TextTrimming="CharacterEllipsis"
                  />
                </Border>
                <Border
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Background="#EE111111"
                  CornerRadius="3"
                  Margin="3"
                >
                  <TextBlock Text="{Binding VideoBadge}" Foreground="White" Padding="5,2" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Border
        x:Name="BusyOverlay"
        Grid.ColumnSpan="7"
        Background="#55000000"
        Visibility="Collapsed"
      >
        <Border
          Background="#EE222222"
          CornerRadius="6"
          Padding="24,14"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
        >
          <StackPanel Orientation="Horizontal">
            <ProgressBar Width="100" Height="8" IsIndeterminate="True" />
            <TextBlock x:Name="BusyText" Margin="12,0,0,0" Foreground="White" />
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </DockPanel>
</Window>
