<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\NewKunlun\Sts2PathDiscovery.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <Reference
      Include="BaseLib"
      HintPath="$(NuGetPackageRoot)alchyr.sts2.baselib\3.4.5\lib\net9.0\BaseLib.dll"
      Private="true"
    />
    <Reference Include="sts2" HintPath="$(Sts2DataDir)\sts2.dll" Private="true" />
    <Reference Include="SmartFormat" HintPath="$(Sts2DataDir)\SmartFormat.dll" Private="true" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)\GodotSharp.dll" Private="true" />
    <Reference
      Include="GodotSharpEditor"
      HintPath="$(NuGetPackageRoot)godotsharpeditor\4.5.1\lib\net8.0\GodotSharpEditor.dll"
      Private="true"
    />
  </ItemGroup>
</Project>
